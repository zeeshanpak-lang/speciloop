# Keep the real value in .env. Never commit it or paste it into chat.
ASSEMBLYAI_API_KEY=replace_with_your_key

# Public-demo voice controls. These counters are process-local.
VOICE_DEMO_ENABLED=false
VOICE_TOKEN_EXPIRY_SECONDS=60
VOICE_MAX_SESSION_SECONDS=120
VOICE_TOKEN_LIMIT_PER_GRANT=4
VOICE_TOKEN_LIMIT_PER_MINUTE=20
VOICE_GRANT_LIMIT_PER_MINUTE=30
VOICE_GRANT_TTL_SECONDS=600
# Optional. Defaults to data/evidence-records.ndjson.
# EVIDENCE_STORE_PATH=C:\path\to\speciloop-evidence.ndjson

# Cloud Run only: use Firestore instead of the local JSONL file.
# EVIDENCE_STORE_BACKEND=firestore
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# FIRESTORE_DATABASE_ID=(default)
# FIRESTORE_COLLECTION_ID=speciloopEvidenceRecords
